{
    "swagger": "2.0",
    "info": {
        "description": "The OpenCost API provides real-time and historical reporting of Kubernetes cloud costs.",
        "title": "OpenCost API",
        "contact": {},
        "license": {
            "name": "Apache 2.0",
            "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0.0"
    },
    "host": "localhost:9003",
    "paths": {
        "/allocation": {
            "get": {
                "description": "Returns costs and resources allocated to workloads. Data is an array of sets (one per step).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "allocation"
                ],
                "summary": "Query costs allocated to Kubernetes workloads",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Time window. Accepts: today, lastweek, 30m, 7d, RFC3339 date pairs, Unix timestamps.",
                        "name": "window",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Field to aggregate by. e.g. namespace, controller, label:app",
                        "name": "aggregate",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Duration per allocation set. Defaults to window.",
                        "name": "step",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "If true, sum entire window into one result set.",
                        "name": "accumulate",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Accumulation option: all, day, week, month, quarter, none",
                        "name": "accumulateBy",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Include idle allocation using Asset data.",
                        "name": "includeIdle",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Compute idle at node level instead of cluster level.",
                        "name": "idleByNode",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Distribute idle costs proportionally across workloads.",
                        "name": "shareIdle",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter expression.",
                        "name": "filter",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Include proportional asset resource costs.",
                        "name": "includeProportionalAssetResourceCosts",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Include aggregated labels and annotations in results.",
                        "name": "includeAggregatedMetadata",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Share load balancer costs across workloads.",
                        "name": "sharelb",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Allocation data wrapped in standard response envelope",
                        "schema": {
                            "$ref": "#/definitions/protocol.HTTPResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameter",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/assets": {
            "get": {
                "description": "Returns costs of Nodes, Disks, and Load Balancers.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "assets"
                ],
                "summary": "Query underlying infrastructure assets",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Time window. Accepts: today, lastweek, 30m, 7d, RFC3339 date pairs, Unix timestamps.",
                        "name": "window",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Filter expression.",
                        "name": "filter",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Asset data wrapped in standard response envelope",
                        "schema": {
                            "$ref": "#/definitions/protocol.HTTPResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameter",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/cloudCost": {
            "get": {
                "description": "Retrieves non-Kubernetes cloud provider costs via cloud integration.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cloudcost"
                ],
                "summary": "Query cloud provider billing data",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Time window. Accepts: today, lastweek, 30m, 7d, RFC3339 date pairs, Unix timestamps.",
                        "name": "window",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Field to aggregate by.",
                        "name": "aggregate",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter expression.",
                        "name": "filter",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cloud cost data wrapped in standard response envelope",
                        "schema": {
                            "$ref": "#/definitions/protocol.HTTPResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameter",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "501": {
                        "description": "Cloud cost integration not configured",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "protocol.HTTPResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {},
                "message": {
                    "type": "string"
                },
                "meta": {
                    "type": "object",
                    "additionalProperties": true
                },
                "warning": {
                    "type": "string"
                }
            }
        }
    }
}